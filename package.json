{
  "name": "castunn",
  "version": "1.2.2",
  "author": "Lumonui",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "version": "node scripts/sync-version.js && git add src/renderer/version.js",
    "version:sync": "node scripts/sync-version.js",
    "test": "node test/signal.test.js",
    "test:unit": "node test/unit.test.mjs",
    "test:essaim": "node test/essaim.test.mjs",
    "test:ui": "electron test/renderer.test.js",
    "test:main": "electron test/main.test.js",
    "test:all": "npm run test:unit && npm run test:essaim && npm run test:nat && npm test && npm run test:ui && npm run test:rtc && npm run test:mesh && npm run test:turn && npm run test:main",
    "dist": "electron-builder -w",
    "test:rtc": "electron test/rtc.test.js",
    "test:nat": "node test/nat.test.js",
    "test:turn": "electron test/turn.test.js",
    "test:mesh": "electron test/mesh.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "express": "^4.19.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "node-turn": "^0.0.6"
  },
  "build": {
    "appId": "com.lumonui.castunn",
    "productName": "Castunn",
    "files": [
      "**/*",
      "!test/**",
      "!.github/**",
      "!CLAUDE.md",
      "!consignes_turn.txt",
      "!docs/**",
      "!scripts/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "discovery.js",
        "to": "discovery.js"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Lumonui",
        "repo": "castunn",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@44.7.2": true
  }
}
